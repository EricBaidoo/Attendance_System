# Deny direct web access to maintenance and test utilities.
<IfModule mod_authz_core.c>
    <FilesMatch "^(password_reset|check_sms_config|check_tither_phone|check_tither_phones|run_db_updates|test_bulksms|test_phone_norm)\.php$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block maintenance and test utilities even when extensionless routes are requested.
    RewriteRule ^(password_reset|check_sms_config|check_tither_phone|check_tither_phones|run_db_updates|test_bulksms|test_phone_norm)$ - [F,L,NC]

    # Canonical URLs: redirect /foo.php -> /foo
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]|$) [NC]
    RewriteRule ^ %1 [R=301,L,NE]

    # Serve extensionless route by mapping /foo -> /foo.php when such file exists.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^(password_reset|check_sms_config|check_tither_phone|check_tither_phones|run_db_updates|test_bulksms|test_phone_norm)\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
